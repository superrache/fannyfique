<UserControl x:Class="Fannyfique.App.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Fannyfique.App.Converters"
             xmlns:ctl="clr-namespace:Fannyfique.App.Controls"
             xmlns:vm="clr-namespace:Fannyfique.App.ViewModels">
    <UserControl.Resources>
        <c:VisibleIfConverter x:Key="VisibleIf"/>
        <!-- Largeur commune des cartes et des colonnes du tableau détaillé, pour qu'elles s'alignent. -->
        <GridLength x:Key="HeaderWidth">230</GridLength>
        <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="CardWidth">252</system:Double>
        <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="CellWidth">264</system:Double>

        <!-- Carte : une copie (CLAUDE.md 7.4) -->
        <DataTemplate x:Key="LotCard" DataType="{x:Type vm:LotCardViewModel}">
            <Border Width="{StaticResource CardWidth}" Margin="0,16,12,16" CornerRadius="10" Background="{DynamicResource SurfaceAlt}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource TypeFill}" Tag="{Binding Type}" CornerRadius="10,10,0,0"/>
                    <StackPanel Grid.Row="1" Margin="14,10,14,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TypeIcon}" Tag="{Binding Type}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TypeLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Folder}" ToolTip="{Binding FullPath}" Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CountText}" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" Margin="0,2,0,10"/>

                        <ProgressBar Height="6" Maximum="1" Value="{Binding Coverage, Mode=OneWay}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                    <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Text="{Binding CoverageText}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding RestText}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding RestText}" Visibility="{Binding RestText, Converter={StaticResource VisibleIf}}"/>
                        <TextBlock Text="{Binding RecoverableText}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0"
                                   Visibility="{Binding RecoverableText, Converter={StaticResource VisibleIf}}"/>

                        <ItemsControl ItemsSource="{Binding Badges}" Margin="0,8,0,0" Visibility="{Binding Badges, Converter={StaticResource VisibleIf}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="6,2" Margin="0,0,4,4" ToolTip="{Binding ToolTip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:BadgeKind.Muted}">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:BadgeKind.Warning}">
                                                        <Setter Property="Background" Value="{DynamicResource WarningSoft}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Text}" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Command="{Binding OpenCommand}" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13"/>
                                <TextBlock Text="Ouvrir le dossier" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Tableau fichier × copie, construit seulement quand la ligne est dépliée -->
        <DataTemplate x:Key="Matrix" DataType="{x:Type vm:GroupViewModel}">
            <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="0,6,0,10">
                <ItemsControl ItemsSource="{Binding Rows}" MaxHeight="380"
                              VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:IdentityRowViewModel}">
                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource HeaderWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="20,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding OtherNamesText}">
                                    <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="{Binding DateText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </TextBlock>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Width="{StaticResource CellWidth}" Padding="0,0,12,0" TextAlignment="Center" VerticalAlignment="Center" FontSize="15">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="✓"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="{x:Static vm:CellKind.Missing}">
                                                                <Setter Property="Text" Value="—"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding}" Value="{x:Static vm:CellKind.Divergent}">
                                                                <Setter Property="Text" Value="⚠"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                                                <Setter Property="ToolTip" Value="Taille différente entre les copies"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Synthèse ===== -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <ctl:DonutChart Width="96" Height="96" Thickness="13" Segments="{Binding Segments}"/>
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Espace récupérable" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding RecoverableText}" Style="{StaticResource BigNumber}" Foreground="{DynamicResource Accent}"/>
                        <ItemsControl ItemsSource="{Binding Segments}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <Border Style="{StaticResource TypeFill}" Tag="{Binding Type}" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Value}" Style="{StaticResource BigNumber}"/>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- ===== Filtres ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Réinitialiser" Command="{Binding ResetFiltersCommand}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ResultText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0"/>
                    <Grid Width="280" HorizontalAlignment="Left">
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="30,6,8,6"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{DynamicResource TextMuted}"
                                   Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <TextBlock Text="Rechercher un dossier…" Style="{StaticResource Muted}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Search, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>
                    </Grid>
                    <CheckBox Content="Avec une carte SD" IsChecked="{Binding OnlySdCards}" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox Content="Lots incomplets" IsChecked="{Binding OnlyIncomplete}" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Du" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding From}" Width="120" Margin="6,0"/>
                        <TextBlock Text="au" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding To}" Width="120" Margin="6,0"/>
                    </StackPanel>
                </DockPanel>
                <WrapPanel Margin="0,12,0,0">
                    <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding SourceFilters}" SelectedItem="{Binding SelectedSource}"
                             DisplayMemberPath="Label" Margin="0,0,18,0"/>
                    <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedType}" Margin="0,0,18,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TypeIcon}" Tag="{Binding Type}" FontSize="12"
                                               Visibility="{Binding Type, Converter={StaticResource VisibleIf}}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Label}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Trier par" Style="{StaticResource Muted}" Margin="0,5,8,0"/>
                        <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Label"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ===== Liste virtualisée des groupes ===== -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Groups}" ItemContainerStyle="{StaticResource PlainItem}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="2,2" VirtualizingPanel.CacheLengthUnit="Item">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GroupViewModel}">
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ctl:WheelBubbling.IsEnabled="True">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource HeaderWidth}"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- En-tête de ligne -->
                                    <StackPanel Margin="20,18,12,16">
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CamerasText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding CopiesText}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding RecoverableText}" Style="{StaticResource BigNumber}" FontSize="24" Foreground="{DynamicResource Accent}" Margin="0,12,0,0"/>
                                        <TextBlock Text="récupérables" Style="{StaticResource Caption}"/>
                                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-10,12,0,0" Padding="10,5"
                                                Command="{Binding ToggleExpandedCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                            <Setter Property="Text" Value="&#xE70D;"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE70E;"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="Détail des fichiers" Margin="8,0,0,0" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource LotCard}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Grid>
                                <ContentControl Content="{Binding}" Focusable="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource Matrix}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- États vides -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding HasAnyGroup, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
            <TextBlock Text="✨" FontSize="44" HorizontalAlignment="Center"/>
            <TextBlock Text="Rien à trier, tout est rangé !" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,6"/>
            <TextBlock Text="Aucun RAW n'a de copie dans un autre dossier. Lance un scan après avoir ajouté de nouvelles sources."
                       Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding NoMatch, Converter={StaticResource VisibleIf}}">
            <TextBlock Text="Aucun résultat pour ces filtres" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
            <Button Content="Réinitialiser les filtres" Command="{Binding ResetFiltersCommand}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
