<UserControl x:Class="Fannyfique.App.Views.SdCardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Fannyfique.App.Converters"
             xmlns:m="clr-namespace:Fannyfique.Core.Model;assembly=Fannyfique.Core">
    <UserControl.Resources>
        <c:VisibleIfConverter x:Key="VisibleIf"/>
    </UserControl.Resources>
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                    Visibility="{Binding IsEmpty, Converter={StaticResource VisibleIf}}">
            <Border Width="88" Height="88" CornerRadius="44" Background="{DynamicResource SurfaceAlt}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F1;" FontSize="38" Foreground="{DynamicResource TypeSdCard}" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="Aucune carte SD" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,20,0,8"/>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Branche une carte : Fannyfique la détecte et propose de l'ajouter. Tu peux aussi donner le type « Carte SD » à une source existante."/>
            <Button Content="Voir les sources" HorizontalAlignment="Center" Margin="0,20,0,0" Command="{Binding GoToSourcesCommand}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AnimatedCard}" Margin="0,0,0,16" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Verdict -->
                                <Border Width="64" Height="64" CornerRadius="32" VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanBeEmptied}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessSoft}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasUniqueFiles}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource WarningSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding VerdictGlyph}" FontSize="28" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanBeEmptied}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasUniqueFiles}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource TypeIcon}" Tag="{x:Static m:SourceType.SdCard}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding VerdictTitle}" Style="{StaticResource H2}" FontSize="22" Margin="0,6,0,2" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource Muted}">
                                        <Run Text="{Binding ContentText, Mode=OneWay}"/>
                                        <Run Text="{Binding FreeableText, Mode=OneWay}" Foreground="{DynamicResource Success}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding OfflineCardNote}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               Visibility="{Binding OfflineCardNote, Converter={StaticResource VisibleIf}}"/>

                                    <!-- Où sont les copies -->
                                    <ItemsControl ItemsSource="{Binding CopyLines}" Margin="0,14,0,0"
                                                  Visibility="{Binding CopyLines, Converter={StaticResource VisibleIf}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="14" Padding="10,4" Margin="0,0,8,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource TypeIcon}" Tag="{Binding Type}" FontSize="13"/>
                                                        <TextBlock Text="{Binding Text}" Margin="6,0,0,0"/>
                                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding Note, Converter={StaticResource VisibleIf}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding OfflineNote}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="{Binding OfflineNote, Converter={StaticResource VisibleIf}}"/>

                                    <!-- Dossiers avec des fichiers uniques -->
                                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasUniqueFiles, Converter={StaticResource VisibleIf}}">
                                        <TextBlock Text="Dossiers à copier avant de vider la carte" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding UniqueLots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource WarningSoft}" CornerRadius="{StaticResource RadiusSmall}" Padding="12,6" Margin="0,0,0,6">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding OpenCommand}" Padding="8,4">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13"/>
                                                                    <TextBlock Text="Ouvrir" Margin="6,0,0,0"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Folder, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                <Run Text="  "/>
                                                                <Run Text="{Binding Count, Mode=OneWay}" Foreground="{DynamicResource TextMuted}"/>
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Content="{Binding ToggleFilesText}"
                                                Command="{Binding ToggleFilesCommand}" Foreground="{DynamicResource Accent}" Padding="0,6"/>

                                        <!-- Fichiers non copiés -->
                                        <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="{StaticResource RadiusSmall}" Padding="12,8"
                                                Visibility="{Binding ShowFiles, Converter={StaticResource VisibleIf}}">
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding UniqueFiles}" MaxHeight="320"
                                                              VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                                                    <ItemsControl.Template>
                                                        <ControlTemplate TargetType="ItemsControl">
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                                                <ItemsPresenter/>
                                                            </ScrollViewer>
                                                        </ControlTemplate>
                                                    </ItemsControl.Template>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="170"/>
                                                                    <ColumnDefinition Width="160"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Date}" Style="{StaticResource Muted}"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Muted}"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding Folder}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding TruncatedNote}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                                           Visibility="{Binding TruncatedNote, Converter={StaticResource VisibleIf}}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2" VerticalAlignment="Top" Command="{Binding OpenCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;"/>
                                        <TextBlock Text="Ouvrir la carte" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
