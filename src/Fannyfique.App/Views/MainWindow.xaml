<Window x:Class="Fannyfique.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Fannyfique.App.ViewModels"
        xmlns:v="clr-namespace:Fannyfique.App.Views"
        xmlns:c="clr-namespace:Fannyfique.App.Converters"
        Title="Fannyfique" Icon="/Assets/app.ico" Width="1320" Height="860" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource TextFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        AllowDrop="True">
    <Window.Resources>
        <c:EqualsConverter x:Key="Equals"/>
        <c:VisibleIfConverter x:Key="VisibleIf"/>
        <DataTemplate DataType="{x:Type vm:SourcesViewModel}">
            <v:SourcesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SdCardsViewModel}">
            <v:SdCardsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}">
            <v:DuplicatesView/>
        </DataTemplate>

        <Style x:Key="NavBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Navigation ===== -->
        <DockPanel Grid.Column="0" Margin="16,20,12,16">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,28">
                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Accent}">
                    <TextBlock Text="F" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="20"
                               Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Fannyfique" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Chasse aux doublons RAW" Style="{StaticResource Caption}"/>
                </StackPanel>
            </StackPanel>

            <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                    Command="{Binding CycleThemeCommand}" ToolTip="Changer de thème">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding ThemeGlyph}" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Text="{Binding ThemeLabel}" Margin="10,0,0,0" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </Button>

            <StackPanel>
                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Sources, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;"/>
                        <TextBlock Text="Sources" Margin="12,0,0,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=SdCards, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F1;"/>
                        <TextBlock Text="Cartes SD" Margin="12,0,0,0"/>
                        <Border Style="{StaticResource NavBadge}" Visibility="{Binding SdCardsBadge, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="{Binding SdCardsBadge}" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Duplicates, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;"/>
                        <TextBlock Text="Doublons" Margin="12,0,0,0"/>
                        <Border Style="{StaticResource NavBadge}" Visibility="{Binding DuplicatesBadge, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="{Binding DuplicatesBadge}" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </DockPanel>

        <!-- ===== Contenu ===== -->
        <Grid Grid.Column="1" Margin="12,20,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding StartScanCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Foreground="{DynamicResource OnAccent}"/>
                        <TextBlock Text="Scanner" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1">
                <!-- Carte SD détectée (CLAUDE.md 4.2) -->
                <Border Style="{StaticResource Banner}" Margin="0,0,0,12"
                        Visibility="{Binding DetectedCard, Converter={StaticResource VisibleIf}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7F1;" Foreground="{DynamicResource TypeSdCard}" FontSize="20"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Ignorer" Command="{Binding DismissDetectedCardCommand}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Ajouter" Margin="8,0" Command="{Binding AddDetectedCardCommand}"/>
                        <TextBlock Text="{Binding DetectedCardText}" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <!-- Bilan du scan (CLAUDE.md 7.5) -->
                <Border Style="{StaticResource Banner}" Background="{DynamicResource SuccessSoft}" Margin="0,0,0,12"
                        Visibility="{Binding ScanSummary, Converter={StaticResource VisibleIf}}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{DynamicResource Success}" FontSize="18"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding DismissSummaryCommand}" ToolTip="Fermer"/>
                            <ToggleButton x:Name="ErrorsToggle" DockPanel.Dock="Right" Style="{StaticResource ButtonBase}" Background="Transparent"
                                          Foreground="{DynamicResource Warning}" Content="{Binding ScanErrorsText}"
                                          Visibility="{Binding ScanErrorsText, Converter={StaticResource VisibleIf}}"/>
                            <TextBlock Text="{Binding ScanSummary}" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ScanErrors}" Margin="30,8,0,0" MaxHeight="180"
                                      Visibility="{Binding IsChecked, ElementName=ErrorsToggle, Converter={StaticResource VisibleIf}}">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,1">
                                        <Run Text="{Binding Path, Mode=OneWay}" Foreground="{DynamicResource Text}"/>
                                        <Run Text="—"/>
                                        <Run Text="{Binding Message, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}" Focusable="False"/>
        </Grid>

        <!-- ===== Scan en cours : par-dessus tout ===== -->
        <v:ScanView Grid.ColumnSpan="2" DataContext="{Binding Scan}"
                    Visibility="{Binding DataContext.IsScanning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIf}}"/>

        <!-- ===== Chargement initial ===== -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource Bg}"
                Visibility="{Binding IsLoading, Converter={StaticResource VisibleIf}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="260">
                <TextBlock Text="Chargement…" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <ProgressBar IsIndeterminate="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
