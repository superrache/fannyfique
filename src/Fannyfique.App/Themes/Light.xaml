<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette Light : chaque type de source a sa couleur, utilisée partout (CLAUDE.md 7.5). -->
    <SolidColorBrush x:Key="Bg" Color="#F7F4F0"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F1EDE7"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#EBE5DD"/>
    <SolidColorBrush x:Key="Stroke" Color="#E3DDD5"/>
    <SolidColorBrush x:Key="Text" Color="#2B2724"/>
    <SolidColorBrush x:Key="TextMuted" Color="#7B726B"/>
    <SolidColorBrush x:Key="Accent" Color="#D9577A"/>
    <SolidColorBrush x:Key="AccentHover" Color="#C4466A"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#FBE6EC"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Success" Color="#2F9467"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#DDF3E8"/>
    <SolidColorBrush x:Key="Warning" Color="#D98A1F"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#FCEFD9"/>
    <SolidColorBrush x:Key="TypePc" Color="#4F86E8"/>
    <SolidColorBrush x:Key="TypeExternalDisk" Color="#8A63D2"/>
    <SolidColorBrush x:Key="TypeNas" Color="#239C86"/>
    <SolidColorBrush x:Key="TypeSdCard" Color="#EE7536"/>
    <SolidColorBrush x:Key="Shadow" Color="#33000000"/>
</ResourceDictionary>
